{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/contact-sales", "destination": "/contact-sales.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/docs", "destination": "/docs.html" },
    {
      "source": "/((?!api/|assets/|images/|favicon.png|logo.png|ordisum-logo.png|robots.txt|sitemap.xml|llms.txt|terms|privacy-policy|refund-policy|features|pricing|security|contact-sales|blog|docs).*)",
      "destination": "/index.html"
    }
  ]
}