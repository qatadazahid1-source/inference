# ─────────────────────────────────────────────────────────────────────────────
# ORDISUM — Frontend Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file with real secrets to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Frontend) ───────────────────────────────────────────────────────
# The anon key is safe to use client-side ONLY because RLS is enabled on all
# tables. Never use the service role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Site / SEO ────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://ordisum.com
VITE_DEFAULT_OG_IMAGE=https://ordisum.com/og-image.png

# ── Backend API URL (only needed if overriding the default proxy) ─────────────
# In production on Vercel, the /api/* rewrite rule forwards to the Render backend.
# You normally do NOT need to set this here.
# VITE_API_URL=https://api.ordisum.com
