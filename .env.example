# ─────────────────────────────────────────────────────────────────────────────
# ORDISUM — Frontend Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file with real secrets to Git.
# Vercel: Configure these in the Vercel Project Settings -> Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Frontend Public) ────────────────────────────────────────────────
# The anon key is safe to use client-side ONLY because RLS is enabled on all
# tables. Never expose the service role key in frontend environment variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Google Cloud Console OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Site / SEO ────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://ordisum.com
VITE_DEFAULT_OG_IMAGE=https://ordisum.com/og-image.png

# ==============================================================================
# Analytics & Tracking
# ==============================================================================
# Plausible Analytics (Privacy-first alternative to GA)
VITE_PLAUSIBLE_DOMAIN="ordisum.com"

# Google Analytics 4 (GA4)
# Defaults to G-466X7SK5SX in the code if not provided
VITE_GA_MEASUREMENT_ID="G-466X7SK5SX"

# ── Backend API URL (Optional local override) ─────────────────────────────────
# In production on Vercel, the /api/* rewrite rule in vercel.json proxies requests to
# the Render backend (https://api.ordisum.com). Set VITE_API_URL only for local overrides.
# VITE_API_URL=https://api.ordisum.com
