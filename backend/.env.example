# ─────────────────────────────────────────────────────────────────────────────
# ORDISUM — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env or any file with real secrets to Git.
# On Render: add these in the Environment tab, NOT in a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must be set to your exact frontend origin in production.
# Without this, CORS defaults to wildcard (*) which is insecure.
FRONTEND_URL=https://ordisum.com
SITE_URL=https://ordisum.com

# ── Supabase (Backend / Service Role) ────────────────────────────────────────
# The service role key bypasses RLS. It must ONLY exist server-side.
# NEVER expose this key in frontend code or any public repository.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Credential Encryption ─────────────────────────────────────────────────────
# AES-256-GCM key used to encrypt stored AI provider API keys.
# Must be a 64-character hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The backend will refuse to start if this is missing.
CREDENTIAL_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# ── Lemon Squeezy (Billing) ───────────────────────────────────────────────────
# Optional at launch. Add when billing features are ready.
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemonsqueezy-webhook-secret

# ── Resend (Email / Alerts) ───────────────────────────────────────────────────
# Optional at launch. Add when alert emails are ready.
RESEND_API_KEY=your-resend-api-key
ALERT_FROM_EMAIL=alerts@ordisum.com

# ── AI / LLM (Pricing Automation) ────────────────────────────────────────────
# Optional. Used by the pricing-automation and report-generation features.
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.your-llm-provider.com/v1
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Azure OpenAI (Optional) ───────────────────────────────────────────────────
# Only needed if using Azure-hosted OpenAI models.
AZURE_OPENAI_ENDPOINT=your-azure-openai-resource-name
